# ─────────────────────────────────────────────────────────────────
# Horizon Capital World — Root Git Ignore
# ─────────────────────────────────────────────────────────────────

# Environment variables & Secrets (CRITICAL: Never commit .env files)
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production Builds
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/

# Vite Cache
.vite/
**/.vite/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
